Global Const $GC_I_ROUTE_FlameTempleCorridor_COUNT = 163


Func MapRoute_GetFlameTempleCorridor(ByRef $a_a_X, ByRef $a_a_Y)
	Return MapRoute_CopyPath1D($aCaravanAscalon_FlameTempleCorridorPath, $a_a_X, $a_a_Y)
EndFunc

Func MapRoute_GetDragonsGullet(ByRef $a_a_X, ByRef $a_a_Y)
	Return MapRoute_GetFlameTempleCorridor($a_a_X, $a_a_Y)
EndFunc

Func MapRoute_IsFlameTempleGulletMap($a_i_MapID = -1)
	If $a_i_MapID < 0 Then $a_i_MapID = Number(Map_GetMapID())
	Return $a_i_MapID = $FlameTempleCorridor_Map Or $a_i_MapID = $DragonsGullet_Map
EndFunc
